  [
   0.04,
   3.86,
   "Boleto vencido de novo? Um agente financeiro cuida disso pra você."
  ],
  [
   4.55,
   6.26,
   "E não paga nada sem a sua aprovação."
  ],
  [
   6.484,
   9.384,
   "Ele lê os boletos e as notas que chegam no seu e-mail."
  ],
  [
   9.984,
   13.314,
   "E anota valor, vencimento e fornecedor numa planilha."
  ],
  [
   13.694,
   16.194,
   "3 dias antes de vencer, ele te avisa."
  ],
  [
   16.704,
   18.584,
   "Com o valor e o link do boleto."
  ],
  [
   18.964,
   22.594,
   "Você responde: pode pagar. Só aí ele agenda o pagamento."
  ],
  [
   22.874,
   25.114,
   "Sem a sua resposta, ele não mexe em nada."
  ],
  [
   25.494,
   30.564,
   "No fim do mês, ele manda um resumo: quanto entrou, quanto saiu e o que vence."
  ],
  [
   31.174,
   34.774,
   "E os limites, quem define é você, nas regras do agente."
  ],
  [
   35.021,
   39.871,
   "Ler, anotar, avisar e esperar o seu sim. Isso é um agente financeiro."
  ],
  [
   40.191,
   41.971,
   "Salva e me segue pra montar o seu."
  ]
