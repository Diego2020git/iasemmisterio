  [
   0.04,
   7.95,
   "O PHP, a linguagem por trás de boa parte dos sites, teve duas falhas críticas. E a inteligência artificial ajudou a encontrar."
  ],
  [
   8.33,
   15.82,
   "O apelido é PHP2Shell: deixa um invasor rodar comandos no servidor, o computador que guarda o site. Sem login."
  ],
  [
   16.2,
   22.36,
   "Vale pra dez anos de versões, e a Wiz invadiu, em teste, WordPress, Drupal e Joomla."
  ],
  [
   22.74,
   29.36,
   "E a IA? A Wiz Research diz que o Gemini ajudou a achar a falha, testar o ataque e conferir a correção."
  ],
  [
   29.586,
   35.696,
   "Ou seja, a IA que acha falha pra proteger também acha pra atacar. Empresas de segurança já viram tentativas de ataque."
  ],
  [
   36.031,
   40.771,
   "Tem site? Um: veja a versão do PHP no painel da hospedagem."
  ],
  [
   41.151,
   47.631,
   "Dois: atualize pra versão corrigida de 21 de outubro. Segundo o PHP, é o único jeito seguro."
  ],
  [
   48.011,
   54.001,
   "Três: no 8.1 ou anterior não sai mais correção. Suba pro 8.2 ou mais nova."
  ],
  [
   54.311,
   56.761,
   "Manda pra quem cuida do seu site e segue o canal."
  ]
