   6.97,
   "Quer saber como a sua cidade votou e o que mudou do primeiro pro segundo turno? Dá pra fazer com IA, grátis, em três passos."
  ],
  [
   7.268,
   13.608,
   "Um: abra o site de resultados do tribunal eleitoral, escolha o seu estado, a sua cidade e o turno."
  ],
  [
   13.847,
   19.117,
   "Dois: copie os votos e a porcentagem de cada candidato, no primeiro e no segundo turno."
  ],
  [
   19.353,
   29.763,
   "Três: cole no Gemini ou no ChatGPT, os dois têm versão grátis, com o pedido: monte uma tabela comparando os dois turnos e diga quem ganhou e quem perdeu votos."
  ],
  [
   30.096,
   35.376,
   "Em segundos, ela organiza tudo e aponta as maiores mudanças. Dá pra pedir um gráfico também."
  ],
  [
   35.603,
   41.003,
   "Mas atenção: IA pode errar conta. Confira cada número com o site antes de postar."
  ],
  [
   41.243,
   46.843,
   "Quer o detalhe por zona eleitoral? O tribunal publica os arquivos completos no portal de dados abertos."
  ],
  [
   47.084,
   48.524,
   "Salva e faz com a sua cidade."
  ]
